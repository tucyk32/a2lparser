            /* CHNL_Y    */ 0x11C09B0 
      /end SOURCE 
  
      /begin TP_BLOB 
		  /* Blob version */ 0x1000001 
          /* PBA          */ 0x0 
          /* RESET_CFG    */ 0x800 
      
	      /begin DISTAB_CFG 
              /* DSPTAB   */ 13 
              /* DAT_MOD  */ 1 
              /* RFG      */ 1 
              /* TRGSEGAD */ 0x9FE000 
			  /* TRG_CFG  */ 0x1020100 
              TRG_MOD 0 255 
		  /end DISTAB_CFG 
      
          CODE_CHK 
            /* ChkSumData   */ 0x11FDF74 
            /* PrgDataLen   */ 0x4 
            /* ChkSumExtRam */ 0x9FFFF8 
            /* PrgExtRamLen */ 0x4 
      
          ETK_CFG 
            0x03 0xD2 0x4D 0xFF 0xEF 0x4E 0xDF 0xEF 0x4E 0xFF 0xFB 0xFE 0xFF 0xFF 0xFE 0xFF 0xFF 0xF0 0x0F 0xFF 0x03 0xCD 0xFF 0xFF 
      
          RESERVED 
            0x11C0058 
            0xAF8 
            EXTERN -1 -1 -1 -1 -1 
      
      /end TP_BLOB 
  /end IF_DATA 

  /begin IF_DATA ASAP1B_KWP2000 
      /begin SOURCE 
	      "timeslot" 
		  4 
		  1 
		  QP_BLOB 
		      0 
			  BLOCKMODE 
			  0xF0 
			  0 
              20 
	  /end SOURCE 
  
	  /begin TP_BLOB 
		  /* Blob version          */ 0x101 
		  /* ECU address on k line */ 0x10 
		  /* requ. tester address  */ 0xF1 
		  /* ECU stimulation mode  */ WuP 
		  /* byte order            */ MSB_FIRST 
          /* ...                   */ 1 
          
		  DATA_ACCESS 
			  /* Flash address */ 0x000000 
			  /* RAM address   */ 0x000000 
              /* Data Read   */ 1 
              /* Code Verify */ 0 
              /* Code Read   */ 0 
              /* Load mode   */ 1 
          
		  /begin CHECKSUM 
              0x010201 
              1 
              1 
              RequestRoutineResults 
              RNC_RESULT 0x23 
          /end CHECKSUM 
          
          /begin FLASH_COPY 
              NOFLASHBACK 
              3 
              RequestRoutineResults 
              RAM_InitByECU 
              0x86 
              COPY_FRAME 1 
              RNC_RESULT 0x23 0xFB 0xFC 
          /end FLASH_COPY 
          
          /begin DIAG_BAUD 
              /* BaudRate */ 38400 
              /* DiagMode */ 0x86 
              BD_PARA 0x50 
          /end DIAG_BAUD 
		  
          /begin DIAG_BAUD 
              /* BaudRate */ 10400 
              /* DiagMode */ 0x86 
              BD_PARA 0x14 
          /end DIAG_BAUD 
		  
          /begin DIAG_BAUD 
              /* BaudRate */ 57600 
              /* DiagMode */ 0x86 
              BD_PARA 0x64 
          /end DIAG_BAUD 
		  
          /begin DIAG_BAUD 
              /* BaudRate */ 125000 
              /* DiagMode */ 0x86 
              BD_PARA 0x87 
          /end DIAG_BAUD 
          
		  /* Timing Parameter: p1Max  p2Min  p2Max  p3Min  p3Max  p4Min */ 
          TIME_DEF             0x0014 0x0000 0x0032 0x0003 0x0200 0x0000 
          TIME_DEF             0x0014 0x0000 0x0032 0x0003 0x0200 0x0001 
          TIME_DEF             20     0      2000   0      5000   65440  
		  
		  /* Seed&Key Parameter: AccMode  CalcMethod  Delay */ 
		   SECURITY_ACCESS        3          1        0    
                   SECURITY_ACCESS        9          1        0    
          
		  /begin PAGE_SWITCH 
		      ESCAPE_CODE 
			  ESCAPE_CODE_PARA 0x90 
			  PAGE_CODE 0x00 0x01 
		  /end PAGE_SWITCH 
		  
	  /end TP_BLOB 
  /end IF_DATA 

