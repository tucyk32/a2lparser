    SYSTEM_CONSTANT "ACCD_SWTSIG_TYPE" "2"
    SYSTEM_CONSTANT "ACCD_SWTSIG_VAL" "0"
    SYSTEM_CONSTANT "ACCD_TIACSTRTDLY_CUR_X" "4"
    SYSTEM_CONSTANT "ACCPED_STGEARSEL_CUR_X" "7"
    SYSTEM_CONSTANT "ACCPED_TRQENGLOW_MAP_X" "16"
    SYSTEM_CONSTANT "ACCPED_TRQENGLOW_MAP_Y" "10"
    SYSTEM_CONSTANT "ACCPED_TRQENG_GMAP_X" "16"
    SYSTEM_CONSTANT "ACCPED_TRQENG_GMAP_Y" "8"
    SYSTEM_CONSTANT "ACCPED_TRQPRPSPORT_MAP_X" "12"
    SYSTEM_CONSTANT "ACCPED_TRQPRPSPORT_MAP_Y" "8"
    SYSTEM_CONSTANT "ACCPED_TRQPRP_MAP_X" "12"
    SYSTEM_CONSTANT "ACCPED_TRQPRP_MAP_Y" "8"
    SYSTEM_CONSTANT "ACCTL_TIDAMAX_MAP_X" "4"
    SYSTEM_CONSTANT "ACCTL_TIDAMAX_MAP_Y" "4"
    SYSTEM_CONSTANT "ACCTL_TIDAMIN_MAP_X" "4"
    SYSTEM_CONSTANT "ACCTL_TIDAMIN_MAP_Y" "4"
    SYSTEM_CONSTANT "ACCTL_TWTHI_CUR_X" "3"
    SYSTEM_CONSTANT "ACC_NORM_FAC" "2777777.77777778"
    SYSTEM_CONSTANT "ACC_RES" "0.001"
    SYSTEM_CONSTANT "ACC_RES_INV" "1000"
    SYSTEM_CONSTANT "ACC_REV_RES" "1"
    SYSTEM_CONSTANT "ACC_SWTAUDI_VW_TYPE" "2"
    SYSTEM_CONSTANT "ACC_SWTAUDI_VW_VAL" "1"
    SYSTEM_CONSTANT "ACC_ZERO" "0"
    SYSTEM_CONSTANT "ACTRQC_SWTCALC_ACCDP" "1"
    SYSTEM_CONSTANT "ACTRQC_SWTCALC_IATSCD" "0"
